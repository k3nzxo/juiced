---
import Icon from "./Icon.astro";
import { useT, DISCORD_INVITE, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const week = [
  { k: "gvg", label: t("kind_gvg") },
  { k: "scrim", label: t("kind_scrim") },
  { k: "ingame", label: t("kind_ingame") },
  { k: "friday", label: t("kind_friday") },
];
---
<section class="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="container hero-copy">
    <span class="pill reveal"><span class="dot"></span>{t("hero2_badge")}</span>
    <h1 data-split>
      {t("hero2_title_1")}<br /><span class="grad-text">{t("hero2_title_2")}</span>
    </h1>
    <p class="lead reveal" style="--d:260ms">{t("hero2_sub")}</p>
    <div class="cta reveal" style="--d:340ms">
      <a class="btn btn-primary" href={`/${lang}/join/`}>{t("hero_cta_join")} <Icon name="arrow" class="arrow" /></a>
      <a class="btn btn-outline" href={DISCORD_INVITE} target="_blank" rel="noopener"><Icon name="discord" /> {t("hero_cta_discord")}</a>
    </div>
  </div>

  <div class="container stage-wrap reveal" style="--d:420ms">
    <div class="stage">
      <canvas class="ribbons" data-ribbons aria-hidden="true"></canvas>

      <div class="float f-week card" aria-hidden="true">
        <div class="f-label">{t("f_week_t")}</div>
        <ul>
          {week.map((w, i) => (
            <li class={`kind-${w.k}`} style={`--i:${i}`}>
              <span class="k-dot"></span><span>{w.label}</span><span class="k-bar"></span>
            </li>
          ))}
        </ul>
        <a class="f-link" href={`/${lang}/schedule/`}>{t("week_cta")} <Icon name="arrow" size={13} /></a>
      </div>

      <div class="float f-region card" aria-hidden="true">
        <span class="f-ico"><Icon name="swords" size={16} /></span>
        <div>
          <div class="f-title">{t("b_gvg_t")} <span class="tag-live">EUW</span></div>
          <div class="f-sub">30 vs 30 · Where Winds Meet</div>
        </div>
      </div>

      <div class="float f-friday card" aria-hidden="true">
        <div class="f-head"><span class="f-badge">{t("f_friday_t")}</span></div>
        <div class="ticker">
          <div class="ticker-track">
            {[...t("b_friday_chips").split("|"), t("b_friday_chips").split("|")[0]].map((g) => <span>{g}</span>)}
          </div>
        </div>
        <p class="f-sub">{t("f_friday_b")}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initRibbons } from "../scripts/ribbons";
  const c = document.querySelector<HTMLCanvasElement>("[data-ribbons]");
  if (c) initRibbons(c);
</script>

<style>
  .hero { position: relative; padding: 72px 0 8px; overflow: hidden; }
  .hero-grid-bg {
    position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 56px 56px; opacity: 0.45;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
    animation: grid-drift 30s linear infinite;
  }
  @keyframes grid-drift { to { background-position: 56px 56px; } }
  .hero-copy { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  h1 { font-size: clamp(42px, 6.6vw, 80px); line-height: 1.02; letter-spacing: -0.035em; max-width: 960px; }
  .lead { max-width: 680px; font-size: clamp(16px, 1.6vw, 19px); color: var(--muted); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }

  .stage-wrap { position: relative; margin-top: 36px; }
  .stage { position: relative; height: 540px; }
  .ribbons { position: absolute; left: 50%; top: 0; width: min(560px, 90%); height: 100%; transform: translateX(-50%); }

  .float { position: absolute; padding: 14px 16px; border-radius: 16px; box-shadow: var(--shadow); background: color-mix(in srgb, var(--surface) 90%, transparent); backdrop-filter: blur(8px); animation: float 7s ease-in-out infinite; }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  .f-label { font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }

  .f-week { left: 0; top: 60px; width: 250px; animation-delay: -1s; }
  .f-week ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .f-week li { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; }
  .k-dot { width: 10px; height: 10px; border-radius: 3px; background: var(--k); flex: none; }
  .k-bar { flex: 1; height: 6px; border-radius: 4px; background: color-mix(in srgb, var(--k) 18%, transparent); position: relative; overflow: hidden; }
  .k-bar::after { content: ""; position: absolute; inset: 0; background: var(--k); border-radius: 4px; transform-origin: left; animation: fill 3.6s var(--ease) infinite; animation-delay: calc(var(--i) * 0.4s); }
  @keyframes fill { 0% { transform: scaleX(0); } 45%, 70% { transform: scaleX(1); } 100% { transform: scaleX(1); opacity: 0; } }
  .f-link { display: inline-flex; align-items: center; gap: 4px; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border); width: 100%; font-size: 12.5px; font-weight: 600; color: var(--c-pink); pointer-events: auto; }

  .f-region { left: 50%; top: 0; transform: translateX(-50%); display: flex; gap: 12px; align-items: center; animation-name: float-c; }
  @keyframes float-c { 0%, 100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, -8px); } }
  .f-ico { width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; color: #fff; background: var(--grad-brand); flex: none; }
  .f-title { font-size: 14.5px; font-weight: 700; display: flex; align-items: center; gap: 8px; white-space: nowrap; }
  .f-sub { font-size: 12.5px; color: var(--muted); }
  .tag-live { font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; padding: 2px 6px; border-radius: 5px; color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); }

  .f-friday { right: 0; top: 140px; width: 260px; animation-delay: -3s; }
  .f-head { margin-bottom: 10px; }
  .f-badge { font-size: 10.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 8px; border-radius: 5px; color: #4d7c0f; background: color-mix(in srgb, #65a30d 14%, transparent); }
  :global([data-theme="dark"]) .f-badge { color: #a3e635; }
  .ticker { height: 34px; overflow: hidden; border-radius: 8px; background: var(--surface-2); border: 1px solid var(--border); }
  .ticker-track { display: flex; flex-direction: column; animation: tick 10s var(--ease) infinite; }
  .ticker-track span { height: 34px; flex: none; display: flex; align-items: center; padding: 0 12px; font-family: var(--font-display); font-weight: 700; font-size: 16px; }
  @keyframes tick {
    0%, 16% { transform: translateY(0); } 20%, 36% { transform: translateY(-34px); } 40%, 56% { transform: translateY(-68px); }
    60%, 76% { transform: translateY(-102px); } 80%, 96% { transform: translateY(-136px); } 100% { transform: translateY(-170px); }
  }
  .f-friday .f-sub { margin-top: 10px; }

  @media (max-width: 980px) {
    .stage { height: 500px; }
    .f-week { top: auto; bottom: 10px; width: 220px; }
    .f-friday { top: auto; bottom: 40px; width: 230px; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 48px; }
    .stage { height: 420px; }
    .f-week { display: none; }
    .f-friday { right: 50%; transform: translateX(50%); animation: none; bottom: 0; }
    .f-region { top: 6px; }
  }
</style>
