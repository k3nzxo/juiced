---
import Icon from "./Icon.astro";
import { useT, DISCORD_INVITE, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section class="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="kicker reveal">EUW · Where Winds Meet</p>
      <h1 class="wordmark reveal" style="--d:80ms">JUICED</h1>
      <p class="lead reveal" style="--d:160ms">{t("hero2_sub")}</p>
      <div class="cta reveal" style="--d:240ms">
        <a class="btn btn-primary" href={`/${lang}/join/`}>{t("hero_cta_join")} <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn-outline" href={DISCORD_INVITE} target="_blank" rel="noopener"><Icon name="discord" /> Discord</a>
      </div>
    </div>
    <div class="hero-art reveal" style="--d:200ms" aria-hidden="true">
      <canvas class="ribbons" data-ribbons></canvas>
    </div>
  </div>
</section>

<script>
  import { initRibbons } from "../scripts/ribbons";
  const c = document.querySelector<HTMLCanvasElement>("[data-ribbons]");
  if (c) initRibbons(c);
</script>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--border); }
  .hero-grid-bg {
    position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 56px 56px; opacity: 0.35;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 50%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 50%, #000 20%, transparent 75%);
  }
  .hero-inner { position: relative; display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 40px; min-height: min(640px, 82vh); padding-top: 48px; padding-bottom: 48px; }
  .hero-copy { display: flex; flex-direction: column; gap: 20px; }
  .kicker { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .wordmark { font-size: clamp(64px, 11vw, 148px); font-weight: 800; letter-spacing: -0.045em; line-height: 0.9; }
  .lead { max-width: 520px; font-size: clamp(16px, 1.5vw, 18px); color: var(--muted); }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .hero-art { position: relative; height: 520px; }
  .ribbons { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; min-height: 0; padding-top: 56px; gap: 8px; }
    .hero-art { height: 320px; }
  }
</style>
