---
import Icon from "./Icon.astro";
import Wordmark from "./Wordmark.astro";
import { useT, DISCORD_INVITE, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section class="hero">
  <canvas class="wind" data-wind aria-hidden="true"></canvas>
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="kicker reveal">EU · Where Winds Meet</p>
      <h1 class="wordmark reveal" style="--d:80ms"><span class="sr-only">JUICED</span><Wordmark /></h1>
      <p class="lead reveal" style="--d:160ms">{t("hero2_sub")}</p>
      <div class="cta reveal" style="--d:240ms">
        <a class="btn btn-primary" href={`/${lang}/join/`}>{t("hero_cta_join")} <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn-outline" href={DISCORD_INVITE} target="_blank" rel="noopener"><Icon name="discord" /> Discord</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--border); }
  .wind { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;
    mask-image: linear-gradient(90deg, rgba(0,0,0,.18) 0%, rgba(0,0,0,.25) 35%, #000 62%), linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
    mask-composite: intersect; -webkit-mask-composite: source-in;
    -webkit-mask-image: linear-gradient(90deg, rgba(0,0,0,.18) 0%, rgba(0,0,0,.25) 35%, #000 62%), linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
    animation: wind-in 1.4s ease both; }
  @keyframes wind-in { from { opacity: 0; } }
  .wordmark { line-height: 1; }
  .wordmark :global(.wm-svg) { display: block; height: 0.73em; width: auto; overflow: visible; }
  @media (max-width: 960px) { .clash { display: none; } }
  .hero-inner { position: relative; display: flex; align-items: center; min-height: min(520px, 70vh); padding-top: 64px; padding-bottom: 64px; }
  .hero-copy { display: flex; flex-direction: column; gap: 20px; }
  .kicker { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .wordmark { font-size: clamp(64px, 11vw, 148px); line-height: 0.9; }
  .lead { max-width: 520px; font-size: clamp(16px, 1.5vw, 18px); color: var(--muted); }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  @media (max-width: 900px) {
    .hero-inner { min-height: 0; padding-top: 56px; padding-bottom: 56px; }
  }
</style>

<script>
  import { initWind } from "../scripts/wind";
  const c = document.querySelector<HTMLCanvasElement>("[data-wind]");
  if (c) initWind(c);
</script>
