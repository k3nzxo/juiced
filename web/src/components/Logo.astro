---
interface Props { size?: number; wordmark?: boolean }
const { size = 30, wordmark = true } = Astro.props;
---
<span class="logo">
  <span class="mark" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.62)}px`} aria-hidden="true">J</span>
  {wordmark && <span class="wordmark">JUICED</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .mark { display: grid; place-items: center; border-radius: 8px; background: var(--accent); color: #fff; font-family: var(--font-display); font-weight: 800; line-height: 1; padding-bottom: 0.04em; }
  .wordmark { font-family: var(--font-display); font-weight: 800; font-size: 19px; letter-spacing: 0.04em; }
</style>
