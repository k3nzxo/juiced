---
interface Props { size?: number; wordmark?: boolean }
const { size = 30, wordmark = true } = Astro.props;
const id = "lg" + Math.random().toString(36).slice(2, 7);
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#FF7A18" />
        <stop offset="0.55" stop-color="#FF3D77" />
        <stop offset="1" stop-color="#8B5CF6" />
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill={`url(#${id})`} />
    <!-- Zitrus-Scheibe: Halbkreis mit Segmenten -->
    <path d="M7.5 15.5a8.5 8.5 0 0 0 17 0Z" fill="none" stroke="#fff" stroke-width="2.2" stroke-linejoin="round" />
    <path d="M16 15.5v8.4M16 15.5l-5.8 6.1M16 15.5l5.8 6.1" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity="0.85" />
    <circle cx="22.5" cy="9" r="2.1" fill="#fff" />
  </svg>
  {wordmark && <span class="wordmark">JUICED</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .wordmark { font-family: var(--font-display); font-weight: 800; font-size: 19px; letter-spacing: 0.02em; }
</style>
