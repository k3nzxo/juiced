---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { useT, langPaths, DISCORD_INVITE, type Lang } from "../../i18n";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const L = {
  pending: t("match_st_pending"), accepted: t("match_st_accepted"), declined: t("match_st_declined"),
  pending_b: t("match_st_pending_b"), accepted_b: t("match_st_accepted_b"), declined_b: t("match_st_declined_b"),
  reply: t("match_reply"), notfound: t("match_notfound"), sent: t("match_sent_on"), times: t("match_times"),
};
---
<Base lang={lang} page="matches" title={t("match_status_t")} noindex>
  <section class="container narrow">
    <span class="eyebrow reveal">{t("kind_scrim")}</span>
    <h1 class="reveal" style="--d:60ms">{t("match_status_t")}</h1>
    <div class="card status reveal" style="--d:120ms" data-status data-lang={lang} data-l={JSON.stringify(L)}>
      <div class="loader"><span class="spinner"></span></div>
    </div>
    <div class="actions reveal" style="--d:180ms">
      <a class="btn btn-outline" href={DISCORD_INVITE} target="_blank" rel="noopener"><Icon name="discord" /> discord.gg/juiced</a>
      <a class="btn btn-ghost" href={`/${lang}/schedule/`}>{t("week_cta")}</a>
    </div>
  </section>
</Base>

<script>
  const el = document.querySelector<HTMLElement>("[data-status]")!;
  const L = JSON.parse(el.dataset.l || "{}");
  const lang = el.dataset.lang || "en";
  const esc = (s: unknown) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  const token = location.hash.slice(1);
  const fail = () => { el.innerHTML = `<p class="nf">${esc(L.notfound)}</p>`; };
  if (!/^[\w-]{16,64}$/.test(token)) fail();
  else fetch(`/api/scrims/status/${encodeURIComponent(token)}`)
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((d) => {
      const when = new Date(d.created_at).toLocaleDateString(lang === "pt" ? "pt-BR" : lang, { day: "numeric", month: "long", year: "numeric" });
      el.dataset.state = d.status;
      el.innerHTML = `
        <div class="st-top"><h2>${esc(d.guild_name)} <span class="vs">vs</span> JUICED</h2><span class="pill pill-${esc(d.status)}"><i></i>${esc(L[d.status] || d.status)}</span></div>
        <p class="st-text">${esc(L[d.status + "_b"] || "")}</p>
        ${d.reply ? `<div class="st-reply"><span>${esc(L.reply)}</span><p>${esc(d.reply)}</p></div>` : ""}
        <dl><div><dt>${esc(L.sent.replace("{d}", ""))}</dt><dd>${esc(when)}</dd></div><div><dt>${esc(L.times)}</dt><dd>${esc(d.proposed_times)}</dd></div></dl>`;
    })
    .catch(fail);
</script>

<style>
  .narrow { max-width: 720px; padding-top: 72px; display: flex; flex-direction: column; gap: 14px; }
  h1 { font-size: clamp(34px, 4.4vw, 50px); }
  .status { padding: 28px; display: flex; flex-direction: column; gap: 16px; min-height: 140px; transition: border-color .3s; }
  .status[data-state="accepted"] { border-color: color-mix(in srgb, var(--ok) 45%, var(--border)); }
  .status :global(.st-top) { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .status :global(h2) { font-size: 22px; }
  .status :global(.vs) { color: var(--faint); font-size: 15px; font-weight: 600; margin: 0 4px; }
  .status :global(.pill) { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; font-size: 13.5px; font-weight: 600; background: var(--surface-2); color: var(--text-2); animation: pop .3s var(--ease); }
  .status :global(.pill i) { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .status :global(.pill-pending i) { animation: pulse 1.6s ease-in-out infinite; }
  .status :global(.pill-accepted) { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); }
  .status :global(.pill-declined) { color: var(--danger); background: color-mix(in srgb, var(--danger) 10%, transparent); }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  @keyframes pop { from { opacity: 0; transform: scale(.94); } to { opacity: 1; transform: none; } }
  .status :global(.st-text) { color: var(--text-2); font-size: 16px; }
  .status :global(.st-reply) { padding: 14px 16px; border-left: 3px solid var(--accent); background: var(--bg-tint); border-radius: 0 10px 10px 0; }
  .status :global(.st-reply span) { font-size: 12.5px; font-weight: 600; color: var(--muted); }
  .status :global(.st-reply p) { white-space: pre-wrap; margin-top: 4px; }
  .status :global(dl) { display: flex; gap: 32px; flex-wrap: wrap; margin: 0; padding-top: 14px; border-top: 1px solid var(--border); font-size: 14px; }
  .status :global(dt) { color: var(--muted); font-size: 12.5px; }
  .status :global(dd) { margin: 2px 0 0; }
  .status :global(.nf) { color: var(--muted); }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; }
</style>
