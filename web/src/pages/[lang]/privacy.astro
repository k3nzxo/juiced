---
import Base from "../../layouts/Base.astro";
import { useT, langPaths, type Lang } from "../../i18n";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
---
<Base lang={lang} page="privacy" title={t("privacy_title")}>
  <article class="container prose">
    <h1>{t("privacy_title")}</h1>
    <p>{t("privacy_p1")}</p>
    <p>{t("privacy_p2")}</p>
    <p>{t("privacy_p3")}</p>
    <p>{t("privacy_p4")}</p>
    <p>{t("privacy_p5")}</p>
  </article>
</Base>

<style>
  .prose { max-width: 720px; padding-top: 72px; display: flex; flex-direction: column; gap: 18px; }
  .prose h1 { font-size: clamp(36px, 4.4vw, 52px); margin-bottom: 8px; }
  .prose p { color: var(--text-2); font-size: 17px; line-height: 1.7; }
</style>
