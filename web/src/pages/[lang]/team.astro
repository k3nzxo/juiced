---
import Base from "../../layouts/Base.astro";
import { useT, langPaths, type Lang } from "../../i18n";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const labels = {
  developer: t("rank_developer"), leader: t("rank_leader"), vice: t("rank_vice"), coach: t("rank_coach"), member: t("rank_member"),
  role_healer: t("role_healer"), role_tank: t("role_tank"), role_nameless: t("role_nameless"), role_twinblades: t("role_twinblades"), role_dps: t("role_dps"), weapon_nameless_sword: t("weapon_nameless_sword"), weapon_strategic_sword: t("weapon_strategic_sword"), weapon_nameless_spear: t("weapon_nameless_spear"), weapon_heavenquaker_spear: t("weapon_heavenquaker_spear"), weapon_infernal_twinblades: t("weapon_infernal_twinblades"), weapon_inkwell_fan: t("weapon_inkwell_fan"), weapon_vernal_umbrella: t("weapon_vernal_umbrella"), weapon_mortal_rope_dart: t("weapon_mortal_rope_dart"), weapon_ninefold_umbrella: t("weapon_ninefold_umbrella"), weapon_stormbreaker_spear: t("weapon_stormbreaker_spear"), weapon_thundercry_blade: t("weapon_thundercry_blade"), weapon_panacea_fan: t("weapon_panacea_fan"), weapon_soulshade_umbrella: t("weapon_soulshade_umbrella"), weapon_ribbon_drum: t("weapon_ribbon_drum"),
  leadership: t("team_leadership"), coaches: t("team_coaches"), members: t("team_members"), empty: t("team_empty"), count: t("team_count"),
};
---
<Base lang={lang} page="team" title={t("team_title")} description={t("team_sub")}>
  <section class="container page-head">
    <span class="eyebrow reveal">JUICED</span>
    <h1 class="reveal" style="--d:60ms">{t("team_title")}</h1>
    <p class="reveal" style="--d:120ms">{t("team_sub")}</p>
    <p class="count reveal" style="--d:180ms" data-count></p>
  </section>
  <section class="container" data-roster data-labels={JSON.stringify(labels)}>
    <div class="grid">{[0, 1, 2, 3].map(() => <div class="person skeleton"></div>)}</div>
  </section>
</Base>

<script>
  import { fetchTeam, personCard, esc } from "../../scripts/team";
  const root = document.querySelector<HTMLElement>("[data-roster]")!;
  const L = JSON.parse(root.dataset.labels || "{}");
  fetchTeam().then((all) => {
    const groups = [
      { title: L.developer, items: all.filter((m) => m.rank === "developer") },
      { title: L.leadership, items: all.filter((m) => ["leader", "vice"].includes(m.rank)) },
      { title: L.coaches, items: all.filter((m) => m.rank === "coach") },
      { title: L.members, items: all.filter((m) => m.rank === "member") },
    ].filter((g) => g.items.length);
    const count = document.querySelector<HTMLElement>("[data-count]");
    if (count && all.length) count.textContent = L.count.replace("{n}", String(all.length));
    if (!groups.length) { root.innerHTML = `<p class="lead-empty">${esc(L.empty)}</p>`; return; }
    root.innerHTML = groups.map((g) => `
      <h2 class="group-title">${esc(g.title)} <span>${g.items.length}</span></h2>
      <div class="grid">${g.items.map((m) => personCard(m, L)).join("")}</div>`).join("");
  }).catch(() => { root.innerHTML = `<p class="lead-empty">${esc(L.empty)}</p>`; });
</script>

<style>
  .page-head { padding-top: 72px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 12px; }
  .page-head h1 { font-size: clamp(40px, 5vw, 60px); }
  .page-head p { color: var(--muted); font-size: 17px; max-width: 620px; }
  .count { font-size: 14px !important; font-weight: 600; color: var(--text-2) !important; min-height: 1.5em; }
  :global(.grid) { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  :global(.group-title) { font-size: 22px; margin: 40px 0 16px; display: flex; align-items: center; gap: 10px; }
  :global(.group-title span) { font-size: 13px; font-family: var(--font-sans); font-weight: 600; color: var(--muted); padding: 2px 8px; border-radius: 999px; border: 1px solid var(--border); }
  :global(.person) { border: 1px solid var(--border); background: var(--surface); border-radius: var(--r-lg); padding: 22px; display: flex; flex-direction: column; gap: 12px; min-height: 170px; transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease); }
  :global(.person:hover) { transform: translateY(-3px); box-shadow: var(--shadow); }
  :global(.person .avatar), :global(.person .avatar-fallback) { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
  :global(.person .avatar-fallback) { display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; font-size: 20px; color: #fff; background: var(--accent); }
  :global(.person .p-name) { font-family: var(--font-display); font-weight: 700; font-size: 18px; }
  :global(.person .p-sub) { font-size: 13.5px; color: var(--muted); display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 4px; }
  :global(.person.skeleton) { background: linear-gradient(90deg, var(--surface-2), var(--surface), var(--surface-2)); background-size: 200% 100%; animation: shimmer 1.6s linear infinite, skel-show 0.25s ease 0.5s both; }
  @keyframes skel-show { from { opacity: 0; } to { opacity: 1; } }
  @keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
  :global(.lead-empty) { padding: 40px; text-align: center; color: var(--muted); border: 1px dashed var(--border-strong); border-radius: var(--r-lg); }
  @media (max-width: 980px) { :global(.grid) { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) {
    :global(.grid) { grid-template-columns: 1fr; gap: 10px; }
    :global(.person) { flex-direction: row; align-items: center; min-height: 0; padding: 14px 16px; gap: 14px; }
    :global(.person .avatar), :global(.person .avatar-fallback) { width: 44px; height: 44px; flex: none; }
    :global(.person.skeleton) { height: 74px; }
  }

  /* Karte: Name + Flagge, darunter Rang, darunter Rolle · Waffen */
  :global(.person .p-info) { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  :global(.person .p-name) { display: flex; align-items: center; gap: 8px; }
  :global(.person .p-name span) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.person .p-name .flag) { flex: none; }
  :global(.person .p-sub) { margin-top: 0; }
  :global(.person .p-role) { display: flex; align-items: center; gap: 6px; font-size: 13.5px; min-width: 0; }
  :global(.person .p-role .weapons) { color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
<style>
  :global(.person:not(.skeleton)) { animation: person-in 0.45s var(--ease) both; }
  :global(.person:nth-child(2)) { animation-delay: 40ms; } :global(.person:nth-child(3)) { animation-delay: 80ms; } :global(.person:nth-child(4)) { animation-delay: 120ms; } :global(.person:nth-child(n+5)) { animation-delay: 160ms; }
  @keyframes person-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
</style>
