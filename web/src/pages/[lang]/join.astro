---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { useT, langPaths, DISCORD_INVITE, type Lang } from "../../i18n";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const roles = ["healer", "tank", "dps"] as const;
const weaponsByRole = { dps: ["nameless_sword", "strategic_sword", "nameless_spear", "heavenquaker_spear", "infernal_twinblades", "inkwell_fan", "vernal_umbrella", "mortal_rope_dart", "ninefold_umbrella"], tank: ["stormbreaker_spear", "thundercry_blade"], healer: ["panacea_fan", "soulshade_umbrella", "ribbon_drum"] } as const;
const msgs = { required: t("join_err_required"), consent: t("join_err_consent"), generic: t("join_err_generic"), url: t("join_err_url"), platform: t("join_err_platform"), vods: t("join_err_vods"), weapon: t("join_err_weapon"), build: t("join_err_build"), inner: t("join_err_inner"), img: t("join_err_img"), remove: t("remove"), region: t("join_err_region"), gs: t("join_err_gs"), shots: t("join_err_shots") };
---
<Base lang={lang} page="join" title={t("join_title")} description={t("join_sub")}>
  <section class="container join">
    <div class="intro">
      <span class="eyebrow reveal">{t("nav_join")}</span>
      <h1 class="reveal" style="--d:60ms">{t("join_title")}</h1>
      <p class="reveal" style="--d:120ms">{t("join_sub")}</p>
      <div class="expect card reveal" style="--d:160ms">
        <h2>{t("join_expect_t")}</h2>
        <ul>{([1, 2, 3, 4, 5, 6, 7] as const).map((n) => <li>{t(`join_expect_${n}`)}</li>)}</ul>
        <p class="expect-note">{t("join_expect_vods")}</p>
      </div>
      <div class="steps card reveal" style="--d:220ms">
        <h2>{t("join_side_t")}</h2>
        <ol>
          <li><span>1</span>{t("join_side_1")}</li>
          <li><span>2</span>{t("join_side_2")}</li>
          <li><span>3</span>{t("join_side_3")}</li>
        </ol>
        <p class="lang-note">{t("join_lang_note")}</p>
        <a class="btn btn-outline btn-sm" href={DISCORD_INVITE} target="_blank" rel="noopener"><Icon name="discord" size={15} /> discord.gg/juiced</a>
      </div>
    </div>

    <div class="form-wrap card reveal" style="--d:120ms">
      <form id="apply" novalidate data-msgs={JSON.stringify(msgs)} data-lang={lang}>
        <div class="row2">
          <div class="field"><label for="f-discord">{t("join_discord")} *</label><input class="input" id="f-discord" name="discord" required maxlength="64" placeholder={t("join_discord_ph")} autocomplete="off" /></div>
          <div class="field"><label for="f-ingame">{t("join_ingame")} *</label><input class="input" id="f-ingame" name="ingame" required maxlength="64" autocomplete="off" /></div>
        </div>
        <div class="field">
          <span class="label">{t("join_role")} *</span>
          <div class="chips" role="radiogroup" data-role-chips>
            {roles.map((r) => <button type="button" class={`chip role-${r}`} aria-pressed="false" data-role={r}>{t(`role_${r}`)}</button>)}
          </div>
        </div>
        <div class="field weapons-field" data-weapons-field hidden>
          <span class="label">{t("join_weapons")} *</span>
          <div class="chips" data-weapon-chips>
            {Object.entries(weaponsByRole).flatMap(([r, ws]) => ws.map((w) => <button type="button" class="chip" aria-pressed="false" data-weapon={w} data-for={r} hidden>{t(`weapon_${w}` as any)}</button>))}
            <input class="input weapon-other" name="weapon_other" maxlength="40" placeholder={t("join_weapon_other")} autocomplete="off" />
          </div>
          <span class="hint">{t("join_weapons_hint")}</span>
        </div>
        <div class="field">
          <span class="label">{t("join_platform")} *</span>
          <label class="check pc-check"><input type="checkbox" name="pc" /> <span>{t("join_pc")}</span></label>
          <span class="hint">{t("join_pc_hint")}</span>
        </div>
        <div class="field">
          <span class="label">{t("join_region")} *</span>
          <div class="chips" data-region-chips>
            {(["eu", "other"] as const).map((r) => <button type="button" class="chip" aria-pressed="false" data-region={r}>{t(`region_${r}`)}</button>)}
          </div>
        </div>
        <div class="field"><label for="f-country">{t("join_country")} *</label><input class="input" id="f-country" name="country" required maxlength="64" placeholder={t("join_country_ph")} /></div>
        <div class="row2">
          <div class="field"><label for="f-gs">{t("join_gs")} *</label><input class="input" id="f-gs" name="gear_score" type="number" inputmode="numeric" min="1" max="999999" required placeholder={t("join_gs_ph")} /></div>
          <div class="field"><label for="f-arena">{t("join_arena")}</label><input class="input" id="f-arena" name="arena_rank" maxlength="40" placeholder={t("join_arena_ph")} autocomplete="off" /></div>
        </div>
        <div class="field">
          <span class="label">{t("join_shots")} *</span>
          <div class="shots-need">
            <span>{t("join_shots_need")}</span>
            <ul>{([1, 2, 3, 4] as const).map((n) => <li>{t(`join_shots_${n}`)}</li>)}</ul>
          </div>
          <label class="shots-drop" data-shots-drop>
            <input type="file" accept="image/png,image/jpeg,image/webp" multiple hidden data-shots-input />
            <Icon name="plus" size={18} />
            <span>{t("join_shots_drop")}</span>
          </label>
          <div class="shots" data-shots></div>
          <span class="hint">{t("join_shots_hint")}</span>
        </div>
        <div class="field"><label for="f-exp">{t("join_exp")} *</label><textarea class="textarea" id="f-exp" name="experience" required maxlength="2000" placeholder={t("join_exp_ph")}></textarea></div>
        <div class="field">
          <span class="label">{t("join_vods")} *</span>
          <div class="links" data-links>
            <input class="input" type="url" inputmode="url" maxlength="300" placeholder="https://" data-link />
          </div>
          <div class="links-foot">
            <span class="hint">{t("join_vods_hint")}</span>
            <button type="button" class="add-link" data-add-link>+ {t("join_vods_add")}</button>
          </div>
        </div>
        <div class="field"><label for="f-why">{t("join_why")}</label><textarea class="textarea" id="f-why" name="why" maxlength="2000" placeholder={t("join_why_ph")} rows="3"></textarea></div>
        <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="check"><input type="checkbox" name="consent" /> <span>{t("join_consent")}</span></label>
        <p class="err" role="alert" hidden></p>
        <button class="btn btn-primary" type="submit">{t("join_submit")} <Icon name="arrow" class="arrow" /></button>
      </form>
      <div class="done" hidden>
        <span class="done-ico"><Icon name="check" size={26} /></span>
        <h2>{t("join_sent_t")}</h2>
        <p>{t("join_sent_b")}</p>
        <a class="btn btn-primary" href={DISCORD_INVITE} target="_blank" rel="noopener"><Icon name="discord" /> discord.gg/juiced</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById("apply") as HTMLFormElement;
  const msgs = JSON.parse(form.dataset.msgs || "{}");
  const err = form.querySelector<HTMLElement>(".err")!;
  let role = "";
  form.querySelectorAll<HTMLButtonElement>("[data-role]").forEach((b) =>
    b.addEventListener("click", () => {
      role = b.dataset.role || "";
      form.querySelectorAll("[data-role]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    }),
  );
  const weapons = new Set<string>();
  const wField = form.querySelector<HTMLElement>("[data-weapons-field]")!;
  form.querySelectorAll<HTMLButtonElement>("[data-weapon]").forEach((b) =>
    b.addEventListener("click", () => {
      const w = b.dataset.weapon!;
      weapons.has(w) ? weapons.delete(w) : weapons.add(w);
      b.setAttribute("aria-pressed", String(weapons.has(w)));
    }),
  );
  form.querySelectorAll<HTMLButtonElement>("[data-role]").forEach((b) =>
    b.addEventListener("click", () => {
      // Waffen der gewählten Rolle zeigen, Auswahl anderer Rollen verwerfen
      const r = b.dataset.role || "";
      form.querySelectorAll<HTMLButtonElement>("[data-weapon]").forEach((x) => {
        const mine = x.dataset.for === r;
        x.hidden = !mine;
        if (!mine && weapons.delete(x.dataset.weapon!)) x.setAttribute("aria-pressed", "false");
      });
      if (wField.hidden) { wField.hidden = false; wField.classList.remove("reveal-in"); void wField.offsetWidth; wField.classList.add("reveal-in"); }
    }),
  );
  // Build-Screenshots: im Browser verkleinern (max. 1800 px, JPEG), dann als Teil der Bewerbung senden
  const MAX_SHOTS = 6;
  let region = "";
  form.querySelectorAll<HTMLButtonElement>("[data-region]").forEach((b) =>
    b.addEventListener("click", () => {
      region = b.dataset.region || "";
      form.querySelectorAll("[data-region]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    }),
  );
  const shots: { data: string }[] = [];
  const shotsEl = form.querySelector<HTMLElement>("[data-shots]")!;
  const shotsInput = form.querySelector<HTMLInputElement>("[data-shots-input]")!;
  const drop = form.querySelector<HTMLElement>("[data-shots-drop]")!;
  const shrink = (file: File) => new Promise<string>((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const im = new Image();
    im.onload = () => {
      const k = Math.min(1, 1800 / Math.max(im.width, im.height));
      const c = document.createElement("canvas");
      c.width = Math.round(im.width * k); c.height = Math.round(im.height * k);
      c.getContext("2d")!.drawImage(im, 0, 0, c.width, c.height);
      URL.revokeObjectURL(url);
      resolve(c.toDataURL("image/jpeg", 0.85));
    };
    im.onerror = () => { URL.revokeObjectURL(url); reject(new Error("img")); };
    im.src = url;
  });
  const drawShots = () => {
    shotsEl.innerHTML = shots.map((s, i) => `<figure class="shot"><img src="${s.data}" alt=""><button type="button" data-rm="${i}" aria-label="${msgs.remove}">×</button></figure>`).join("");
    drop.hidden = shots.length >= MAX_SHOTS;
  };
  const addFiles = async (files: FileList | File[]) => {
    for (const f of [...files]) {
      if (shots.length >= MAX_SHOTS) break;
      if (!/^image\/(png|jpeg|webp)$/.test(f.type)) { err.textContent = msgs.img; err.hidden = false; continue; }
      try { shots.push({ data: await shrink(f) }); } catch { err.textContent = msgs.img; err.hidden = false; }
    }
    drawShots();
  };
  shotsInput.addEventListener("change", () => { if (shotsInput.files) addFiles(shotsInput.files); shotsInput.value = ""; });
  ["dragenter", "dragover"].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add("over"); }));
  ["dragleave", "drop"].forEach((ev) => drop.addEventListener(ev, () => drop.classList.remove("over")));
  drop.addEventListener("drop", (e) => { e.preventDefault(); if ((e as DragEvent).dataTransfer?.files) addFiles((e as DragEvent).dataTransfer!.files); });
  shotsEl.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("[data-rm]");
    if (b) { shots.splice(Number(b.dataset.rm), 1); drawShots(); }
  });

  const links = form.querySelector<HTMLElement>("[data-links]")!;
  const addBtn = form.querySelector<HTMLButtonElement>("[data-add-link]")!;
  addBtn.addEventListener("click", () => {
    const n = links.querySelectorAll("[data-link]").length;
    if (n >= 5) return;
    const inp = document.createElement("input");
    inp.className = "input link-in"; inp.type = "url"; inp.inputMode = "url"; inp.maxLength = 300; inp.placeholder = "https://";
    inp.setAttribute("data-link", "");
    links.appendChild(inp);
    inp.focus();
    if (n + 1 >= 5) addBtn.hidden = true;
  });
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    err.hidden = true;
    const fd = new FormData(form);
    const val = (k: string) => String(fd.get(k) || "").trim();
    const vodLinks = [...links.querySelectorAll<HTMLInputElement>("[data-link]")].map((i) => i.value.trim()).filter(Boolean);
    const payload = {
      discord: val("discord"), ingame: val("ingame"), main_role: role, country: val("country"),
      experience: val("experience"), why: val("why"), website: val("website"), lang: form.dataset.lang,
      platforms: form.querySelector<HTMLInputElement>("[name=pc]")!.checked ? ["pc"] : [], vod_links: vodLinks,
      weapons: [...weapons], weapon_other: val("weapon_other"),
      build_images: shots.map((s) => s.data),
      region, gear_score: Number(val("gear_score")) || 0, arena_rank: val("arena_rank"),
    };
    if (!payload.discord || !payload.ingame || !role || !payload.country || !payload.experience) {
      err.textContent = msgs.required; err.hidden = false; return;
    }
    if (!weapons.size && !payload.weapon_other) { err.textContent = msgs.weapon; err.hidden = false; return; }
    if (!payload.platforms.length) { err.textContent = msgs.platform; err.hidden = false; return; }
    if (!region) { err.textContent = msgs.region; err.hidden = false; return; }
    if (!payload.gear_score || payload.gear_score < 1) { err.textContent = msgs.gs; err.hidden = false; form.querySelector<HTMLElement>("#f-gs")?.focus(); return; }
    if (!shots.length) { err.textContent = msgs.shots; err.hidden = false; drop.scrollIntoView({ block: "center", behavior: "smooth" }); return; }
    if (!vodLinks.length) { err.textContent = msgs.vods; err.hidden = false; links.querySelector<HTMLInputElement>("[data-link]")?.focus(); return; }
    if (vodLinks.some((u) => !/^https?:\/\/[^\s<>"']+$/i.test(u))) { err.textContent = msgs.url; err.hidden = false; return; }
    if (!fd.get("consent")) { err.textContent = msgs.consent; err.hidden = false; return; }
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    btn.disabled = true;
    try {
      const r = await fetch("/api/applications", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
      if (!r.ok) {
        const d = await r.json().catch(() => null);
        throw new Error(d?.detail || msgs.generic);
      }
      form.hidden = true;
      (document.querySelector(".done") as HTMLElement).hidden = false;
    } catch (ex) {
      err.textContent = (ex as Error).message || msgs.generic; err.hidden = false; btn.disabled = false;
    }
  });
</script>

<style>
  .join { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; padding-top: 72px; align-items: start; }
  .intro { display: flex; flex-direction: column; gap: 14px; }
  .intro h1 { font-size: clamp(38px, 4.6vw, 56px); }
  .intro > p { color: var(--muted); font-size: 17px; }
  .steps { padding: 22px; margin-top: 12px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .steps h2 { font-size: 17px; }
  .lang-note { font-size: 14px; color: var(--text-2); padding-top: 12px; border-top: 1px solid var(--border); width: 100%; }
  .steps ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .steps li { display: flex; gap: 12px; align-items: flex-start; font-size: 15px; color: var(--text-2); }
  .steps li span { flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 700; color: #fff; background: var(--grad-brand); }
  .form-wrap { padding: 32px; }
  form { display: flex; flex-direction: column; gap: 18px; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .err { color: var(--danger); font-size: 14px; font-weight: 500; }
  form .btn { align-self: flex-start; }
  .chip[aria-pressed="true"] { background: var(--role, var(--text)); border-color: var(--role, var(--text)); color: var(--bg); }
  .chip[class*="role-"][aria-pressed="true"] { color: #fff; }
  .links { display: flex; flex-direction: column; gap: 8px; }
  :global(.link-in) { animation: link-in 0.35s var(--ease); }
  @keyframes link-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .links-foot { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; align-items: center; }
  .hint { font-size: 12.5px; color: var(--muted); }
  .add-link { font-size: 13.5px; font-weight: 600; color: var(--c-pink); }
  .add-link:hover { text-decoration: underline; }
  .done { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 12px 0; }
  .done-ico { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: var(--ok); animation: pop-in 0.5s var(--ease); }
  @keyframes pop-in { from { transform: scale(0.6); opacity: 0; } to { transform: none; opacity: 1; } }
  .done h2 { font-size: 26px; }
  .done p { color: var(--muted); }
  @media (max-width: 900px) { .join { grid-template-columns: 1fr; gap: 32px; } .intro { position: static; } }
  @media (max-width: 560px) { .row2 { grid-template-columns: 1fr; } .form-wrap { padding: 22px; } }
  /* gleiche Höhe und Form wie die Waffen-Buttons daneben */
  .weapon-other { width: auto; flex: 1 1 160px; min-width: 140px; height: 32px; padding: 0 14px; border-radius: 999px; font-size: 13.5px; }
  @media (max-width: 600px) { .weapon-other { height: 38px; font-size: 16px; } }
  .reveal-in { animation: field-in 0.35s var(--ease); }
  @keyframes field-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .shots-drop { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 64px; padding: 14px; border: 1.5px dashed var(--border-strong); border-radius: 12px; color: var(--muted); font-size: 14px; cursor: pointer; transition: border-color .2s, background-color .2s, color .2s; }
  .shots-drop:hover, :global(.shots-drop.over) { border-color: var(--accent); color: var(--text); background: var(--accent-soft); }
  .shots-drop[hidden] { display: none; }
  .shots { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .shots:empty { display: none; }
  :global(.shot) { position: relative; margin: 0; aspect-ratio: 16 / 10; border-radius: 10px; overflow: hidden; border: 1px solid var(--border); background: var(--surface-2); animation: field-in .3s var(--ease); }
  :global(.shot img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  :global(.shot button) { position: absolute; top: 4px; right: 4px; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font-size: 16px; line-height: 1; color: #fff; background: rgba(0,0,0,.6); }
  :global(.shot button:hover) { background: var(--danger); }
  @media (max-width: 560px) { .shots { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .shots-need { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; padding: 10px 12px; border-radius: 10px; background: var(--bg-tint); border: 1px solid var(--border); font-size: 13.5px; color: var(--muted); }
  .shots-need ul { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0; padding: 0; list-style: none; color: var(--text-2); font-weight: 500; }
  .shots-need li::before { content: "✓"; color: var(--accent); margin-right: 5px; font-weight: 700; }
  .shots { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .expect { padding: 22px; margin-top: 12px; display: flex; flex-direction: column; gap: 12px; }
  .expect h2 { font-size: 17px; }
  .expect ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .expect li { position: relative; padding-left: 22px; font-size: 14.5px; color: var(--text-2); line-height: 1.45; }
  .expect li::before { content: ""; position: absolute; left: 2px; top: 7px; width: 8px; height: 8px; border-radius: 2px; background: var(--accent); }
  .expect-note { font-size: 13.5px; font-weight: 600; color: var(--text); padding-top: 12px; border-top: 1px solid var(--border); }
  .pc-check { align-items: center; font-weight: 500; color: var(--text); }
</style>
