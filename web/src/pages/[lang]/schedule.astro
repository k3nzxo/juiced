---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { dict, useT, langPaths, type Lang } from "../../i18n";
import "../../styles/schedule.css";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const d = dict(lang);
const L = Object.fromEntries(Object.entries(d).filter(([k]) => k.startsWith("kind_") || k.startsWith("sched_")));
const kinds = ["gvg", "raid", "scrim", "ingame", "friday", "other"] as const;
---
<Base lang={lang} page="schedule" title={t("sched_title")} description={t("sched_sub")}>
  <section class="container page-head">
    <span class="eyebrow reveal">JUICED</span>
    <h1 class="reveal" style="--d:60ms">{t("sched_title")}</h1>
    <p class="reveal" style="--d:120ms">{t("sched_sub")} <span data-tz></span></p>
  </section>

  <section class="container">
    <div class="sched-bar reveal" style="--d:160ms">
      <div class="sched-nav">
        <button class="icon-nav" data-week="-1" aria-label={t("sched_prev")}><Icon name="arrow" size={16} class="flip" /></button>
        <button class="btn btn-outline btn-sm" data-week="0">{t("sched_this")}</button>
        <button class="icon-nav" data-week="1" aria-label={t("sched_next")}><Icon name="arrow" size={16} /></button>
        <strong class="range" data-range></strong>
      </div>
      <div class="legend">{kinds.map((k) => <span class={`kind-${k}`}>{t(`kind_${k}`)}</span>)}</div>
    </div>
    <div class="week" data-week-grid data-lang={lang} data-l={JSON.stringify(L)} data-tz-text={t("sched_tz")}></div>
    <div class="sched-cta reveal">
      <p>{t("cta_scrim_b")}</p>
      <a class="btn btn-primary btn-sm" href={`/${lang}/matches/`}>{t("cta_scrim_btn")} <Icon name="arrow" size={15} class="arrow" /></a>
    </div>
  </section>
</Base>

<script>
  import { addDays, dateFmt, fetchEvents, renderWeek, startOfWeek } from "../../scripts/schedule";
  const grid = document.querySelector<HTMLElement>("[data-week-grid]")!;
  const lang = grid.dataset.lang || "en";
  const L = JSON.parse(grid.dataset.l || "{}");
  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC";
  document.querySelector("[data-tz]")!.textContent = (grid.dataset.tzText || "").replace("{tz}", tz);
  let offset = 0;
  const load = async () => {
    const monday = addDays(startOfWeek(), offset * 7);
    const sunday = addDays(monday, 6);
    const df = dateFmt(lang);
    document.querySelector("[data-range]")!.textContent = `${df.format(monday)} – ${df.format(sunday)}`;
    grid.classList.add("loading");
    try { renderWeek(grid, await fetchEvents(monday, addDays(monday, 7)), monday, lang, L); }
    catch { renderWeek(grid, [], monday, lang, L); }
    grid.classList.remove("loading");
  };
  document.querySelectorAll<HTMLElement>("[data-week]").forEach((b) => b.addEventListener("click", () => {
    const v = Number(b.dataset.week);
    offset = v === 0 ? 0 : offset + v;
    load();
  }));
  load();
</script>

<style>
  .page-head { padding-top: 72px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 12px; }
  .page-head h1 { font-size: clamp(40px, 5vw, 60px); }
  .page-head p { color: var(--muted); font-size: 17px; max-width: 680px; }
  .sched-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
  .sched-nav { display: flex; align-items: center; gap: 8px; }
  .icon-nav { width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--surface); display: grid; place-items: center; color: var(--text-2); transition: border-color 0.15s; }
  .icon-nav:hover { border-color: var(--text); }
  :global(.flip) { transform: scaleX(-1); }
  .range { margin-left: 8px; font-size: 15px; font-variant-numeric: tabular-nums; }
  :global(.week.loading) { opacity: 0.5; transition: opacity 0.2s; }
  .sched-cta { margin-top: 32px; display: flex; gap: 16px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 20px 24px; border: 1px dashed var(--border-strong); border-radius: 16px; }
  .sched-cta p { color: var(--text-2); }
</style>
