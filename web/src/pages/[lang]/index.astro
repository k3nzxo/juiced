---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import { dict, useT, langPaths, DISCORD_INVITE, type Lang } from "../../i18n";
import "../../styles/schedule.css";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const d = dict(lang);
const L = Object.fromEntries(Object.entries(d).filter(([k]) => k.startsWith("kind_") || k.startsWith("sched_")));
const ranks = { developer: t("rank_developer"), leader: t("rank_leader"), vice: t("rank_vice"), coach: t("rank_coach"), role_healer: t("role_healer"), role_tank: t("role_tank"), role_nameless: t("role_nameless") };
const tiles = [
  { k: "gvg", icon: "swords", title: t("b_gvg_t"), body: t("b_gvg_b"), wide: true },
  { k: "scrim", icon: "users", title: t("b_custom_t"), body: t("b_custom_b"), link: { href: `/${lang}/matches/`, label: t("b_custom_cta") } },
  { k: "ingame", icon: "calendar", title: t("b_events_t"), body: t("b_events_b") },
  { k: "friday", icon: "layers", title: t("b_friday_t"), body: t("b_friday_b") },
  { k: "other", icon: "play", title: t("b_review_t"), body: t("b_review_b") },
];
---
<Base lang={lang} page="home">
  <Hero lang={lang} />

  <section class="section">
    <div class="container">
      <header class="sec-head">
        <h2 class="reveal">{t("b_title")}</h2>
      </header>
      <div class="tiles">
        {tiles.map((x, i) => (
          <article class:list={["tile", "reveal", `kind-${x.k}`, { wide: x.wide }]} style={`--d:${i * 70}ms`}>
            <div class="tile-main">
              <span class="tile-ico"><Icon name={x.icon} size={18} /></span>
              <h3>{x.title}</h3>
              <p>{x.body}</p>
              {x.link && <a class="tile-link" href={x.link.href}>{x.link.label} <Icon name="arrow" size={14} /></a>}
            </div>
            {x.wide && <div class="next-gvg" data-next-gvg data-label={t("b_gvg_next")} data-lang={lang} hidden></div>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="sec-head row">
        <h2 class="reveal">{t("week_title")}</h2>
        <a class="btn btn-outline btn-sm reveal" href={`/${lang}/schedule/`}>{t("week_cta")} <Icon name="arrow" size={15} /></a>
      </header>
      <div class="week" data-home-week data-lang={lang} data-l={JSON.stringify(L)}></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="sec-head row">
        <h2 class="reveal">{t("lead_title")}</h2>
        <a class="btn btn-outline btn-sm reveal" href={`/${lang}/team/`}>{t("lead_cta")} <Icon name="arrow" size={15} /></a>
      </header>
      <div class="lead-grid" data-lead-grid data-empty={t("lead_empty")} data-ranks={JSON.stringify(ranks)}>
        {[0, 1, 2, 3].map(() => <div class="person skeleton"></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container duo">
      <div class="cta-card reveal">
        <h2>{t("cta_join_t")}</h2>
        <p>{t("cta_join_b")}</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href={`/${lang}/join/`}>{t("hero_cta_join")} <Icon name="arrow" class="arrow" /></a>
          <a class="btn btn-outline" href={DISCORD_INVITE} target="_blank" rel="noopener"><Icon name="discord" /> Discord</a>
        </div>
      </div>
      <div class="cta-card reveal" style="--d:100ms">
        <h2>{t("cta_scrim_t")}</h2>
        <p>{t("cta_scrim_b")}</p>
        <div class="cta-actions">
          <a class="btn btn-outline" href={`/${lang}/matches/`}>{t("cta_scrim_btn")} <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { renderLeadership } from "../../scripts/team";
  import { addDays, fetchEvents, renderWeek, startOfWeek } from "../../scripts/schedule";

  const grid = document.querySelector<HTMLElement>("[data-lead-grid]");
  if (grid) renderLeadership(grid);

  // Nächste GvG-Termine in der GvG-Kachel
  const ng = document.querySelector<HTMLElement>("[data-next-gvg]");
  if (ng) {
    const now = new Date();
    const loc = ng.dataset.lang === "pt" ? "pt-BR" : ng.dataset.lang || "en";
    const day = new Intl.DateTimeFormat(loc, { weekday: "long", day: "numeric", month: "short" });
    const time = new Intl.DateTimeFormat(loc, { hour: "2-digit", minute: "2-digit" });
    fetchEvents(now, addDays(now, 14)).then((ev) => {
      const list = ev.filter((e) => e.kind === "gvg" && new Date(e.starts_at) > now).slice(0, 4);
      if (!list.length) return;
      ng.innerHTML = `<div class="ng-label">${ng.dataset.label}</div>` + list.map((e, i) => {
        const d = new Date(e.starts_at);
        return `<div class="ng-row" style="--i:${i}"><strong>${day.format(d)}</strong><span>${time.format(d)}</span></div>`;
      }).join("");
      ng.hidden = false;
    }).catch(() => {});
  }

  const week = document.querySelector<HTMLElement>("[data-home-week]");
  if (week) {
    const monday = startOfWeek();
    const L = JSON.parse(week.dataset.l || "{}");
    fetchEvents(monday, addDays(monday, 7))
      .then((ev) => renderWeek(week, ev, monday, week.dataset.lang || "en", L))
      .catch(() => renderWeek(week, [], monday, week.dataset.lang || "en", L));
  }
</script>

<style>
  .section { padding: 88px 0 0; }
  .sec-head { margin-bottom: 28px; }
  .sec-head h2 { font-size: clamp(28px, 3.2vw, 40px); }
  .sec-head.row { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }

  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .tile { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 8px; transition: border-color 0.2s, transform 0.3s var(--ease); }
  .tile:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .tile.wide { grid-column: span 2; flex-direction: row; align-items: stretch; gap: 24px; }
  .tile-main { display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .next-gvg { flex: 1; display: flex; flex-direction: column; gap: 8px; border-left: 1px solid var(--border); padding-left: 24px; justify-content: center; }
  :global(.ng-label) { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }
  :global(.ng-row) { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 12px; border-radius: 10px; background: var(--surface-2); font-size: 14px; animation: ng-in 0.5s var(--ease) both; animation-delay: calc(var(--i) * 80ms); }
  :global(.ng-row strong) { font-weight: 600; text-transform: capitalize; }
  :global(.ng-row span) { color: var(--muted); font-variant-numeric: tabular-nums; }
  @keyframes ng-in { from { opacity: 0; transform: translateX(8px); } to { opacity: 1; transform: none; } }
  .tile-ico { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; color: var(--k); background: color-mix(in srgb, var(--k) 12%, transparent); margin-bottom: 8px; }
  .tile.kind-other .tile-ico { color: var(--text-2); background: var(--surface-2); }
  .tile h3 { font-size: 19px; }
  .tile p { color: var(--muted); font-size: 15px; max-width: 46ch; }
  .tile-link { margin-top: 6px; display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--accent); }
  .tile-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .lead-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  :global(.person) { border: 1px solid var(--border); background: var(--surface); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; min-height: 160px; transition: transform 0.3s var(--ease), border-color 0.2s; }
  :global(.person:hover) { transform: translateY(-2px); border-color: var(--border-strong); }
  :global(.person .avatar), :global(.person .avatar-fallback) { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
  :global(.person .avatar-fallback) { display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; font-size: 20px; color: #fff; background: var(--accent); }
  :global(.person .p-name) { font-family: var(--font-display); font-weight: 700; font-size: 17px; }
  :global(.person .p-sub) { font-size: 13.5px; color: var(--muted); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 4px; }
  :global(.person.skeleton) { background: linear-gradient(90deg, var(--surface-2), var(--surface), var(--surface-2)); background-size: 200% 100%; animation: shimmer 1.6s linear infinite; }
  @keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
  :global(.lead-empty) { grid-column: 1 / -1; padding: 32px; text-align: center; color: var(--muted); border: 1px dashed var(--border-strong); border-radius: 16px; }

  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .cta-card { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 36px; display: flex; flex-direction: column; gap: 10px; }
  .cta-card h2 { font-size: clamp(24px, 2.6vw, 32px); }
  .cta-card p { color: var(--muted); }
  .cta-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }

  @media (max-width: 900px) {
    .tiles { grid-template-columns: 1fr 1fr; }
    .lead-grid { grid-template-columns: repeat(2, 1fr); }
    .duo { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .section { padding-top: 64px; }
    .tiles { grid-template-columns: 1fr; }
    .tile.wide { grid-column: span 1; flex-direction: column; }
    .next-gvg { border-left: 0; padding-left: 0; border-top: 1px solid var(--border); padding-top: 14px; }
    .lead-grid { grid-template-columns: 1fr; }
    .cta-card { padding: 26px; }
  }
</style>
