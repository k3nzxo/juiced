---
import Base from "../../layouts/Base.astro";
import { dict, langPaths, useT, type Lang } from "../../i18n";
import "../../styles/app.css";
import "../../styles/vods.css";
import "../../styles/schedule.css";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
---
<Base lang={lang} page="app" title={t("app_title")} noindex>
  <div class="container app-wrap">
    <div id="app-root" data-lang={lang} data-dict={JSON.stringify(dict(lang))}>
      <div class="app-center"><div class="loader"><span class="spinner"></span></div></div>
    </div>
  </div>
</Base>

<script>
  import { start } from "../../scripts/app/main";
  start();
</script>
