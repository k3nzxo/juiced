# --- Pflicht ---------------------------------------------------------------
DB_PASSWORD=
SECRET_KEY=

# --- Discord-Login (discord.com/developers -> Application -> OAuth2) ---------
# Redirect-URL dort eintragen: https://juiced.team/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Deine Discord-User-ID(s): sind immer Leader (kommagetrennt)
OWNER_DISCORD_IDS=

# --- Optional: Rollen vom JUICED-Discord übernehmen -------------------------
DISCORD_GUILD_ID=
# rang:rollen-id, kommagetrennt. Ränge: leader, vice, member, coach_healer, coach_tank, coach_nameless
DISCORD_ROLE_MAP=

# --- Optional: Benachrichtigungen ------------------------------------------
# Webhook eines privaten Kanals der Leitung (neue Bewerbungen)
DISCORD_APPLY_WEBHOOK=
# Bot-Token derselben Discord-App (für DMs an Coaches / Spieler)
DISCORD_BOT_TOKEN=

# --- VODs -----------------------------------------------------------------
# Ordner auf dem Server (z. B. auf der Storage Box)
VOD_HOST_DIR=./data/vods
VOD_MAX_TOTAL_GB=25
VOD_MAX_FILE_GB=12
VOD_RETENTION_DAYS=7
VOD_MAX_PER_USER=0
VOD_MIN_FREE_GB=5
# 1 = nur hochladen, wenn im VOD-Ordner die Datei ".storagebox" liegt (Schutz, falls die Box nicht eingehängt ist)
VOD_REQUIRE_MARKER=0
